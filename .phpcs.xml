<?xml version="1.0"?>
<!-- PSR-12, lignes de 120 caractères au plus (lancé par la CI officielle GLPI). -->
<ruleset name="DockerInventory">
    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="extensions" value="php"/>
    <arg value="p"/>

    <file>setup.php</file>
    <file>hook.php</file>
    <file>src</file>
    <file>front</file>
    <file>tests</file>

    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>

    <!-- Fonctions de hook et pages front/ : forme imposée par GLPI (fonctions globales en
         snake_case, script qui exécute du code). -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>setup.php</exclude-pattern>
        <exclude-pattern>front/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <!-- Compat/Base : chaque fichier déclare sa classe deux fois, dans deux branches exclusives
         (propriétés typées en GLPI 12, non typées en GLPI 11). -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>src/Compat/Base/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Classes.DuplicateClassName">
        <exclude-pattern>src/Compat/Base/*</exclude-pattern>
    </rule>
</ruleset>
