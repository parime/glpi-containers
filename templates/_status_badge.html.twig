{# Pastille « Actif » / « Retiré » d'un service. #}
{% if retired %}
    <span class="badge bg-secondary text-white">
        <i class="ti ti-archive me-1" aria-hidden="true"></i>{{ __('Retiré', 'containers') }}
    </span>
{% else %}
    <span class="badge bg-success text-white">
        <i class="ti ti-circle-check me-1" aria-hidden="true"></i>{{ __('Actif', 'containers') }}
    </span>
{% endif %}
