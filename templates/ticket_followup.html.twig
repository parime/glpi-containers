{# Suivi d'un ticket de mise à jour encore ouvert, quand la situation du service change. #}
<p>
    {% if kind == 'resolved' %}
        <strong>{{ __('Écart résolu', 'dockerinventory') }}</strong> :
        {{ __('le service est à jour en version', 'dockerinventory') }} {{ deployed }}.
    {% elseif kind == 'below_threshold' %}
        <strong>{{ __('Écart sous le seuil', 'dockerinventory') }}</strong> :
        {{ deployed }} → {{ latest ?: '-' }} ({{ gap.label }}).
    {% else %}
        <strong>{{ __('Nouvelle situation', 'dockerinventory') }}</strong> :
        {{ deployed }} → {{ latest }} ({{ gap.label }}).
    {% endif %}
</p>
<p>
    {{ __('Situation précédente', 'dockerinventory') }} :
    {{ previous.deployed_tag ?: '-' }} → {{ previous.latest_tag ?: '-' }} ({{ previous_gap.label }}).
</p>
<p>
    {{ __('Suivi ajouté par Inventaire Docker : le statut du ticket n’est pas modifié.', 'dockerinventory') }}
    <a href="{{ service_url }}">{{ __('Voir le service dans GLPI', 'dockerinventory') }}</a>
</p>
