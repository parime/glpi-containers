{# Description d'un ticket de mise à jour (texte enrichi du ticket). #}
<p>
    {{ __('Une version plus récente de l’image de ce service est disponible.', 'dockerinventory') }}
</p>
<ul>
    <li><strong>{{ __('Service', 'dockerinventory') }}</strong> : {{ service }}</li>
    {% if stack %}
        <li><strong>{{ __('Stack', 'dockerinventory') }}</strong> : {{ stack }}</li>
    {% endif %}
    {% if appliance %}
        <li><strong>{{ __('Application', 'dockerinventory') }}</strong> : {{ appliance }}</li>
    {% endif %}
    <li><strong>{{ __('Image', 'dockerinventory') }}</strong> : {{ image }}</li>
    <li><strong>{{ __('Version déployée', 'dockerinventory') }}</strong> : {{ deployed }}</li>
    <li><strong>{{ __('Dernière version', 'dockerinventory') }}</strong> : {{ latest }}</li>
    <li><strong>{{ __('Écart', 'dockerinventory') }}</strong> : {{ gap.label }} ({{ gap.help }})</li>
    <li><strong>{{ __('Source', 'dockerinventory') }}</strong> : {{ source }}</li>
</ul>
<p>
    <a href="{{ service_url }}">{{ __('Voir le service dans GLPI', 'dockerinventory') }}</a>
</p>
<p>
    {{ __('Ticket créé par Inventaire Docker, seuil choisi :', 'dockerinventory') }} {{ threshold }}.
    {{ __(
        'Un suivi sera ajouté si la situation change ; jamais de changement de statut, de priorité ni d’affectation.',
        'dockerinventory'
    ) }}
</p>
