{# Connexion Portainer. La clé d'API n'est jamais renvoyée au navigateur : le champ reste vide,
   et le laisser vide en modification conserve la clé enregistrée. #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {% set key_helper = has_api_key
        ? __('Une clé est enregistrée (chiffrée) : laisser vide pour la conserver.', 'containers')
        : __("Jeton d'accès d'un utilisateur Portainer dédié, aux droits de lecture seuls.", 'containers') %}
    {% set environment_helper = __(
        "Appliqué seulement aux applications créées par l'import, jamais aux applications existantes.",
        'containers'
    ) %}

    {{ fields.textField('name', item.fields['name'], __('Name'), {
        required: true,
        helper: __('Nom libre, par exemple « Portainer production ».', 'containers'),
    }) }}
    {{ fields.dropdownYesNo('is_active', item.fields['is_active'] ?? 1, __('Active'), {
        helper: __("Une connexion inactive n'est pas importée par la tâche automatique.", 'containers'),
    }) }}
    {{ fields.textField('url', item.fields['url'], __('Adresse de Portainer', 'containers'), {
        required: true,
        placeholder: 'https://portainer.exemple.test:9443',
        helper: __("Adresse de l'interface Portainer, sans /api à la fin.", 'containers'),
    }) }}
    {{ fields.passwordField('api_key', '', __("Clé d'API", 'containers'), {
        required: item.isNewItem(),
        clearable: false,
        helper: key_helper,
    }) }}
    {{ fields.dropdownYesNo('allow_http', item.fields['allow_http'] ?? 0, __('Autoriser HTTP', 'containers'), {
        helper: __("Déconseillé : la clé d'API circule alors en clair.", 'containers'),
    }) }}
    {{ fields.dropdownField(
        'ApplianceEnvironment',
        'applianceenvironments_id',
        item.fields['applianceenvironments_id'],
        __('Environnement des applications créées', 'containers'),
        {helper: environment_helper}
    ) }}
    {{ fields.textareaField('comment', item.fields['comment'], _n('Comment', 'Comments', 1)) }}
{% endblock %}
