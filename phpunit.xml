<?xml version="1.0" encoding="UTF-8"?>
<!-- Lancé dans une vraie instance GLPI (plugin installé et activé) : la CI officielle GLPI détecte
     ce fichier. Les tests unitaires (tests/Unit) n'utilisent pas la base, les tests d'intégration
     (tests/Integration) écrivent dans la base de test et nettoient ce qu'ils créent. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         cacheDirectory=".phpunit-cache">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
